# OnePlus Pad 2 Pro OPD2413 / OP615EL1, SM8750P (sun).
# Initial Android-only port; scanout format/stride are discovered at boot.
# Observed Android modes: 3392x2400, native landscape; rotation awaits testing.
# PMK8550 PON: power=116, resin/volume-up=115; PM8550 GPIO6: volume-down=114.
CONFIG_QCOM_KEYS=y
CONFIG_QCOM_SPMI=y
CONFIG_QCOM_KEY_DEBOUNCE_SAMPLES=2
# CONFIG_KSHIM_QEMU_PLATFORM is not set
CONFIG_KSHIM_FRAMEBUFFER=y
CONFIG_KSHIM_LVGL=y
CONFIG_KSHIM_UI_ROTATION_CCW=0
CONFIG_KSHIM_MENU_ENTRY_DURATION_MS=0
# 32 draw rows per buffer at the observed 3392-pixel landscape width.
CONFIG_KSHIM_LVGL_BUFFER_BYTES=434176
CONFIG_KSHIM_LVGL_HEAP_BYTES=1048576
CONFIG_KSHIM_MENU_STYLE_STAR_CHART=y
CONFIG_KSHIM_MENU_CHINESE=y
CONFIG_KSHIM_MENU_LANGUAGE_SWITCH=y
CONFIG_KSHIM_MENU_ENTRY_DETAILS=y
CONFIG_KSHIM_MENU_BASE_ANDROID=y
CONFIG_KSHIM_MENU_SESSION_SETTINGS=y
CONFIG_KSHIM_MENU_POWER_ACTIONS=y
CONFIG_KSHIM_MENU_ADVANCED_ACTIONS=y
CONFIG_KSHIM_QCOM_REBOOT=y
# CONFIG_KSHIM_EDL_DISABLE_SDI is not set
# CONFIG_KSHIM_EDL_PROBE is not set
# CONFIG_KSHIM_STORAGE_ENTRY_PROBE is not set
# CONFIG_KSHIM_UFS_NATIVE_IO is not set
# CONFIG_KSHIM_UFS_LINK_WAKE is not set
# CONFIG_KSHIM_UFS_DEVICE_WAKE is not set
# CONFIG_KSHIM_UFS_READ_PROBE is not set
# CONFIG_KSHIM_UFS_READ_SCREEN is not set
# CONFIG_KSHIM_UFS_SETTINGS is not set
# CONFIG_KSHIM_SETTINGS_SAVE_TEST is not set
# CONFIG_KSHIM_TB323FU_ANDROID_TOUCH_4M8 is not set
# CONFIG_KSHIM_TOUCH is not set
# CONFIG_KSHIM_SMP is not set
# CONFIG_KSHIM_UEFI_TEST_MENU is not set
# CONFIG_KSHIM_BOOT_TIMING is not set
# CONFIG_ENABLE_BANNER is not set
CONFIG_DEBUG_LEVEL_NONE=y
# CONFIG_KSHIM_DEBUG_CONSOLE is not set
CONFIG_ASSERT_HALT=y

CONFIG_KSHIM_PAD2PRO_MENU_PREVIEW=y
CONFIG_KSHIM_PAD2PRO_KEY_PROBE=y
CONFIG_KSHIM_PAD2PRO_MENU_KEYS=y

CONFIG_KSHIM_EXT4_BOOT=y
CONFIG_KSHIM_BOOT_PARTUUID="d4d95497-250b-4023-98eb-a8977664e385"
CONFIG_KSHIM_BOOT_PARTLABEL="ARMADA_BOOT"

CONFIG_KSHIM_UI_ATLAS=y
CONFIG_KSHIM_MENU_SINGLE_LINUX=y
