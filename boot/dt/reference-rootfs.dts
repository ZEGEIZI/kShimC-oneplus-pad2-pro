				vddrfa0p8-supply = <0x86>;
				vddrfa1p2-supply = <0x87>;
				vddrfa1p8-supply = <0x88>;
				vddpcie0p9-supply = <0x89>;
				vddpcie1p8-supply = <0x8a>;
				phandle = <0xc1>;
			};
		};
	};

	pcie0_phy: phy@1c06000 {
		compatible = "qcom,sm8750-qmp-gen3x2-pcie-phy";
		reg = <0x00 0x1c06000 0x00 0x2000>;
		clocks = <0x15 0x25 0x15 0x27 0x16 0x00 0x15 0x29 0x15 0x2b>;
		clock-names = "aux", "cfg_ahb", "ref", "rchng", "pipe";
		assigned-clocks = <0x15 0x29>;
		assigned-clock-rates = <0x5f5e100>;
		resets = <0x15 0x07>;
		reset-names = "phy";
		power-domains = <0x15 0x01>;
		#clock-cells = <0x00>;
		clock-output-names = "pcie0_pipe_clk";
		#phy-cells = <0x00>;
		status = "okay";
		vdda-phy-supply = <0x77>;
		vdda-pll-supply = <0x18>;
		required-opps = <0x1a>;
		phandle = <0x0f>;
	};

	wcn_pmu: wireless-pmu {
		compatible = "oneplus,opd2413-wcn-pmu", "qcom,wcn7860-pmu";
		qcom,qmp = <0x37>;
		qcom,pdc-init-table = "{class: wlan_pdc, ss: rf, res: s5f.m, enable: 1}", "{class: wlan_pdc, ss: rf, res: s5f.v, enable: 1}", "{class: wlan_pdc, ss: rf, res: s5f.v, upval: 876}", "{class: wlan_pdc, ss: rf, res: s5f.v, dwnval: 876}";
		pinctrl-names = "init", "default", "active";
		pinctrl-0;
		pinctrl-1;
		pinctrl-2 = <0x8b 0x8c 0x8d 0x8e 0x8f>;
		wlan-enable-gpios = <0x25 0x10 0x00>;
		bt-enable-gpios = <0x0b 0x03 0x00>;
		vddio-supply = <0x90>;
		vddio1p2-supply = <0x91>;
		vddaon-supply = <0x92>;
		vdddig-supply = <0x93>;
		vddrfa1p2-supply = <0x7c>;
		vddrfa1p8-supply = <0x94>;
		phandle = <0xc2>;

		regulators {

			wcn_rfa_cmn: ldo0 {
				regulator-name = "opd2413-wcn-rfa-cmn";
				phandle = <0x82>;
			};

			wcn_aon: ldo1 {
				regulator-name = "opd2413-wcn-aon";
				phandle = <0x83>;
			};

			wcn_wlcx: ldo2 {
				regulator-name = "opd2413-wcn-wlcx";
				phandle = <0x84>;
			};

			wcn_wlmx: ldo3 {
				regulator-name = "opd2413-wcn-wlmx";
				phandle = <0x85>;
			};

			wcn_btcmx: ldo4 {
				regulator-name = "opd2413-wcn-btcmx";
				phandle = <0xc3>;
			};

			wcn_rfa_0p8: ldo5 {
				regulator-name = "opd2413-wcn-rfa-0p8";
				phandle = <0x86>;
			};

			wcn_rfa_1p2: ldo6 {
				regulator-name = "opd2413-wcn-rfa-1p2";
				phandle = <0x87>;
			};

			wcn_rfa_1p8: ldo7 {
				regulator-name = "opd2413-wcn-rfa-1p8";
				phandle = <0x88>;
			};

			wcn_pcie_0p9: ldo8 {
				regulator-name = "opd2413-wcn-pcie-0p9";
				phandle = <0x89>;
			};

			wcn_pcie_1p8: ldo9 {
				regulator-name = "opd2413-wcn-pcie-1p8";
				phandle = <0x8a>;
			};
		};
	};

	smp2p-adsp {
		compatible = "qcom,smp2p";
		interrupts-extended = <0x31 0x03 0x02 0x01>;
		mboxes = <0x31 0x03 0x02>;
		qcom,smem = <0x1bb 0x1ad>;
		qcom,local-pid = <0x00>;
		qcom,remote-pid = <0x02>;

		smp2p_adsp_out: master-kernel {
			qcom,entry-name = "master-kernel";
			#qcom,smem-state-cells = <0x01>;
			phandle = <0x99>;
		};

		smp2p_adsp_in: slave-kernel {
			qcom,entry-name = "slave-kernel";
			interrupt-controller;
			#interrupt-cells = <0x02>;
			phandle = <0x95>;
		};
	};

	tcsr_mutex: hwlock@1f40000 {
		compatible = "qcom,tcsr-mutex";
		reg = <0x00 0x1f40000 0x00 0x20000>;
		#hwlock-cells = <0x01>;
		phandle = <0x04>;
	};

	lpass_ag_noc: interconnect@7e40000 {
		compatible = "qcom,sm8750-lpass-ag-noc";
		reg = <0x00 0x7e40000 0x00 0xe080>;
		qcom,bcm-voters = <0x14>;
		#interconnect-cells = <0x02>;
		phandle = <0xc4>;
	};

	lpass_lpiaon_noc: interconnect@7400000 {
		compatible = "qcom,sm8750-lpass-lpiaon-noc";
		reg = <0x00 0x7400000 0x00 0x19080>;
		qcom,bcm-voters = <0x14>;
		#interconnect-cells = <0x02>;
		phandle = <0xc5>;
	};

	lpass_lpicx_noc: interconnect@7420000 {
		compatible = "qcom,sm8750-lpass-lpicx-noc";
		reg = <0x00 0x7420000 0x00 0x44080>;
		qcom,bcm-voters = <0x14>;
		#interconnect-cells = <0x02>;
		phandle = <0x96>;
	};

	remoteproc_adsp: remoteproc@3000000 {
		compatible = "qcom,sm8750-adsp-pas", "qcom,sm8550-adsp-pas";
		reg = <0x00 0x3000000 0x00 0x10000>;
		interrupts-extended = <0x06 0x06 0x01 0x95 0x00 0x01 0x95 0x01 0x01 0x95 0x02 0x01 0x95 0x03 0x01 0x95 0x07 0x01>;
		interrupt-names = "wdog", "fatal", "ready", "handover", "stop-ack", "shutdown-ack";
		clocks = <0x11 0x00>;
		clock-names = "xo";
		interconnects = <0x96 0x00 0x07 0x1c 0x01 0x07>;
		power-domains = <0x02 0x04 0x02 0x05>;
		power-domain-names = "lcx", "lmx";
		memory-region = <0x97 0x98>;
		qcom,qmp = <0x37>;
		qcom,smem-states = <0x99 0x00>;
		qcom,smem-state-names = "stop";
		status = "okay";
		firmware-name = "qcom/sm8750/oneplus/opd2413/adsp.mdt", "qcom/sm8750/oneplus/opd2413/adsp_dtb.mdt";
		phandle = <0xc6>;

		glink-edge {
			interrupts-extended = <0x31 0x03 0x00 0x01>;
			mboxes = <0x31 0x03 0x00>;
			qcom,remote-pid = <0x02>;
			label = "lpass";

			gpr {
				compatible = "qcom,gpr";
				qcom,glink-channels = "adsp_apps";
				qcom,domain = <0x02>;
				qcom,intents = <0x200 0x14>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				q6apm: service@1 {
					compatible = "qcom,q6apm";
					reg = <0x01>;
					#sound-dai-cells = <0x00>;
					qcom,protection-domain = "avs/audio", "msm/adsp/audio_pd";
					phandle = <0xc7>;

					q6apmbedai: bedais {
						compatible = "qcom,q6apm-lpass-dais";
						#sound-dai-cells = <0x01>;
						phandle = <0xc8>;
					};

					q6apmdai: dais {
						compatible = "qcom,q6apm-dais";
						iommus = <0x1f 0x1001 0x00 0x1f 0x1081 0x00 0x1f 0x1041 0x00 0x1f 0x1061 0x00>;
						phandle = <0xc9>;
					};
				};

				q6prm: service@2 {
					compatible = "qcom,q6prm";
					reg = <0x02>;
					qcom,protection-domain = "avs/audio", "msm/adsp/audio_pd";
					phandle = <0xca>;

					q6prmcc: clock-controller {
						compatible = "qcom,q6prm-lpass-clocks";
						#clock-cells = <0x02>;
						phandle = <0xcb>;
					};
				};
			};
		};
	};

