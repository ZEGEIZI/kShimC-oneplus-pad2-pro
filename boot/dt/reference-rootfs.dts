	gpi_dma2: dma-controller@800000 {
		compatible = "qcom,sm8750-gpi-dma", "qcom,sm6350-gpi-dma";
		reg = <0x00 0x800000 0x00 0x60000>;
		interrupts = <0x00 0x24c 0x04 0x00 0x24d 0x04 0x00 0x24e 0x04 0x00 0x24f 0x04 0x00 0x250 0x04 0x00 0x251 0x04 0x00 0x252 0x04 0x00 0x253 0x04 0x00 0x254 0x04 0x00 0x255 0x04 0x00 0x256 0x04 0x00 0x257 0x04>;
		dma-channels = <0x0c>;
		dma-channel-mask = <0x1e>;
		#dma-cells = <0x03>;
		iommus = <0x1f 0x436 0x00>;
		status = "okay";
		phandle = <0x58>;
	};

	qupv3_2: geniqup@8c0000 {
		compatible = "qcom,geni-se-qup";
		reg = <0x00 0x8c0000 0x00 0x2000>;
		clocks = <0x15 0x81 0x15 0x82>;
		clock-names = "m-ahb", "s-ahb";
		iommus = <0x1f 0x423 0x00>;
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;
		status = "okay";
		phandle = <0xb7>;

		uart14: serial@898000 {
			phandle = <0xce>;
			status = "okay";
			pinctrl-names = "default";
			pinctrl-0 = <0xcd>;
			interconnect-names = "qup-core", "qup-config";
			interconnects = <0x26 0x02 0x07 0x26 0x05 0x07 0x1d 0x02 0x07 0x1e 0x14 0x07>;
			clock-names = "se";
			clocks = <0x15 0x79>;
			interrupt-parent = <0x01>;
			interrupts = <0x00 0x1cd 0x04>;
			reg = <0x00 0x898000 0x00 0x4000>;
			compatible = "qcom,geni-uart";

			bluetooth {
				vddaon-supply = <0x83>;
				max-speed = <0x7a1200>;
				compatible = "oneplus,opd2413-brahma20-bt";
			};
		};

		i2c11: i2c@88c000 {
			compatible = "qcom,geni-i2c";
			reg = <0x00 0x88c000 0x00 0x4000>;
			interrupts = <0x00 0x249 0x04>;
			clocks = <0x15 0x73>;
			clock-names = "se";
			clock-frequency = <0x186a0>;
			interconnects = <0x26 0x02 0x07 0x26 0x05 0x07 0x1d 0x02 0x07 0x1e 0x14 0x07 0x21 0x01 0x07 0x1c 0x01 0x07>;
			interconnect-names = "qup-core", "qup-config", "qup-memory";
			dmas = <0x58 0x00 0x03 0x03 0x58 0x01 0x03 0x03>;
			dma-names = "tx", "rx";
			pinctrl-0 = <0x59>;
			pinctrl-names = "default";
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			status = "okay";
			phandle = <0xb8>;

			ktz_secondary: backlight@11 {
				compatible = "kinetic,ktz8868-secondary";
				reg = <0x11>;
				phandle = <0x5b>;
			};
		};
	};

	i2c_master_hub_0: geniqup@9c0000 {
		compatible = "qcom,geni-se-i2c-master-hub";
		reg = <0x00 0x9c0000 0x00 0x2000>;
		clocks = <0x15 0x53>;
		clock-names = "s-ahb";
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;
		status = "okay";
		phandle = <0xb9>;

		i2c_hub_9: i2c@9a4000 {
			phandle = <0xd2>;
			status = "okay";
			#size-cells = <0x00>;
			#address-cells = <0x01>;
			clock-frequency = <0x61a80>;
			pinctrl-names = "default";
			pinctrl-0 = <0xd0>;
			interconnect-names = "qup-core", "qup-config";
			interconnects = <0x26 0x00 0x07 0x26 0x03 0x07 0x1d 0x02 0x07 0x1e 0x09 0x07>;
			clock-names = "se", "core";
			clocks = <0x15 0x51 0x15 0x3e>;
			interrupts = <0x00 0x1d9 0x04>;
			interrupt-parent = <0x01>;
			reg = <0x00 0x9a4000 0x00 0x4000>;
			compatible = "qcom,geni-i2c-master-hub";

			amplifier@36 {
				awinic,audio-channel = <0x06>;
				reg = <0x36>;
				compatible = "oneplus,opd2413-aw88261-id";
			};

			amplifier@35 {
				awinic,audio-channel = <0x02>;
				reg = <0x35>;
				compatible = "oneplus,opd2413-aw88261-id";
			};

			amplifier@34 {
				awinic,audio-channel = <0x00>;
				reg = <0x34>;
				compatible = "oneplus,opd2413-aw88261-id";
			};
		};

		i2c_hub_4: i2c@990000 {
			phandle = <0xd1>;
			status = "okay";
			#size-cells = <0x00>;
			#address-cells = <0x01>;
