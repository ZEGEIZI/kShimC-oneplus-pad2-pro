/dts-v1/;

/ {
	model = "OnePlus Pad 2 Pro (OPD2413) bootc rootfs study";
	compatible = "oneplus,opd2413", "qcom,sm8750";
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	interrupt-parent = <0x01>;

	aliases {
		serial0 = "/geniqup@8c0000/serial@898000";
	};

	chosen {
		armada,rootfs-profile = "opd2413-bootc-rootfs-v1";
		armada,full-module-profile = "opd2413-rfkill-complete-modules-v1";
		armada,speaker-id-profile = "opd2413-aw88261-id-v1";
		armada,bluetooth-profile = "opd2413-brahma20-uart-v1";
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;
		bootargs = "console=null rdinit=/init loglevel=7 ignore_loglevel nokaslr clk_ignore_unused pd_ignore_unused regulator_ignore_unused panic=0 msm.separate_gpu_kms=1 initcall_debug=1 drm.debug=0x1ff gpi.opd2413_boot_trace=1 qcom_rpmh_regulator.opd2413_boot_observe=1 qcom_rpmh_regulator.opd2413_l12b_oem_vote=1 selinux=0 root=UUID=5fd35e74-51d8-4c08-9c9c-86b75d0c06fd rootflags=subvol=/root,noatime,compress=zstd:1 rw boot=UUID=562b7490-45ea-4e58-8255-7516f27f0c3c rootwait quiet allow_mismatched_32bit_el0 fw_devlink.strict=1 pcie_ports=compat psi=1 cgroup_disable=pressure cgroup.memory=nokmem,nosocket cpufreq.default_governor=schedutil swiotlb=8192 ostree=/ostree/boot.1/default/abefcd0bd1443f66f702c6191dd61481fdf9c7b19ed814e644eeb5454efba60c/0 sd_mod.opd2413_read_only=0";
		armada,boot-stage = "maintenance";
		armada,input-profile = "opd2413-native-v1";
		kshim,initrd-entry = <0x03>;
		armada,boot-display-profile = "opd2413-mmcx-nom-l1-v1";
		armada,usb-profile = "opd2413-usb2-acm-v1";
		armada,touch-profile = "opd2413-xn242-nt36536-v1";
		armada,gpu-profile = "opd2413-a830v2-v1";
		armada,thermal-profile = "opd2413-tsens-v1";
		armada,backlight-profile = "opd2413-dual-ktz8868-v1";
		armada,native-display-profile = "opd2413-xn242-quad-study-v1";
		armada,native-display-candidate = "opd2413-native-fbdev-v1";
		armada,storage-profile = "opd2413-ufs-explicit-parent-study-v1";
		armada,storage-open-gates = "parent-wiring", "phy-mx-domain", "native-shared-rail-unwind";
		armada,storage-display-baseline = "diag39";
		armada,cpu-profile = "opd2413-scmi-cpu-v1";

		framebuffer {
			compatible = "simple-framebuffer";
			status = "disabled";
			power-domains = <0x02 0x06>;
			required-opps = <0x03>;
		};
	};

	memory@0 {
		device_type = "memory";
		reg = <0x00 0x00 0x00 0x00>;
	};

	reserved-memory {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;

		wlan-iova-reservations {
			iommu-addresses = <0xc1 0x00 0x00 0x00 0x00 0x18000000 0xc1 0x00 0x00 0xb0000000 0x00 0x50000000 0xc0 0x00 0x00 0x00 0x00 0x18000000 0xc0 0x00 0x00 0xb0000000 0x00 0x50000000>;
			phandle = <0xcc>;
		};

		ramoops@880000000 {
			compatible = "ramoops";
			reg = <0x08 0x80000000 0x00 0x240000>;
			console-size = <0x40000>;
			pmsg-size = <0x200000>;
			record-size = <0x00>;
			ftrace-size = <0x00>;
			mem-type = <0x00>;
			no-map;
		};

		cmd-db@81c60000 {
			compatible = "qcom,cmd-db";
			reg = <0x00 0x81c60000 0x00 0x20000>;
			no-map;
		};

		gpu_zap_mem: gpu-zap-shader@9b09a000 {
			reg = <0x00 0x9b09a000 0x00 0x2000>;
			no-map;
			phandle = <0x35>;
		};

		smem_mem: smem@81d00000 {
			compatible = "qcom,smem";
			reg = <0x00 0x81d00000 0x00 0x200000>;
			hwlocks = <0x04 0x03>;
			no-map;
			phandle = <0x9a>;
		};

		adspslpi_mem: adsp@9ee00000 {
			reg = <0x00 0x9ee00000 0x00 0x5080000>;
			no-map;
			phandle = <0x97>;
		};

		q6_adsp_dtb_mem: adsp-dtb@9ed80000 {
			reg = <0x00 0x9ed80000 0x00 0x80000>;
			no-map;
			phandle = <0x98>;
		};
	};

	cpus {
		#address-cells = <0x02>;
		#size-cells = <0x00>;

		opd_cpu0: cpu@0 {
			device_type = "cpu";
			compatible = "qcom,oryon", "arm,armv8";
			reg = <0x00 0x00>;
			enable-method = "psci";
			power-domains = <0x05 0x00>;
			power-domain-names = "perf";
			#cooling-cells = <0x02>;
			phandle = <0x3b>;
		};

		opd_cpu1: cpu@100 {
			device_type = "cpu";
			compatible = "qcom,oryon", "arm,armv8";
			reg = <0x00 0x100>;
			enable-method = "psci";
			power-domains = <0x05 0x00>;
			power-domain-names = "perf";
			#cooling-cells = <0x02>;
			phandle = <0x9b>;
		};

		opd_cpu2: cpu@200 {
			device_type = "cpu";
			compatible = "qcom,oryon", "arm,armv8";
			reg = <0x00 0x200>;
			enable-method = "psci";
			power-domains = <0x05 0x00>;
			power-domain-names = "perf";
			#cooling-cells = <0x02>;
			phandle = <0x9c>;
		};

		opd_cpu3: cpu@300 {
			device_type = "cpu";
			compatible = "qcom,oryon", "arm,armv8";
			reg = <0x00 0x300>;
			enable-method = "psci";
			power-domains = <0x05 0x00>;
			power-domain-names = "perf";
			#cooling-cells = <0x02>;
			phandle = <0x9d>;
		};

		opd_cpu4: cpu@400 {
			device_type = "cpu";
			compatible = "qcom,oryon", "arm,armv8";
			reg = <0x00 0x400>;
			enable-method = "psci";
			power-domains = <0x05 0x00>;
			power-domain-names = "perf";
			#cooling-cells = <0x02>;
			phandle = <0x9e>;
		};

		opd_cpu5: cpu@500 {
			device_type = "cpu";
			compatible = "qcom,oryon", "arm,armv8";
			reg = <0x00 0x500>;
			enable-method = "psci";
			power-domains = <0x05 0x00>;
			power-domain-names = "perf";
			#cooling-cells = <0x02>;
			phandle = <0x9f>;
		};

		opd_cpu6: cpu@10000 {
			device_type = "cpu";
			compatible = "qcom,oryon", "arm,armv8";
			reg = <0x00 0x10000>;
			enable-method = "psci";
			power-domains = <0x05 0x01>;
			power-domain-names = "perf";
			#cooling-cells = <0x02>;
			phandle = <0x49>;
		};

		opd_cpu7: cpu@10100 {
			device_type = "cpu";
			compatible = "qcom,oryon", "arm,armv8";
			reg = <0x00 0x10100>;
			enable-method = "psci";
			power-domains = <0x05 0x01>;
			power-domain-names = "perf";
			#cooling-cells = <0x02>;
			phandle = <0xa0>;
		};
	};

	psci {
		compatible = "arm,psci-1.0";
		method = "smc";
	};

	gic: interrupt-controller@16000000 {
		compatible = "arm,gic-v3";
		#interrupt-cells = <0x03>;
		interrupt-controller;
		#redistributor-regions = <0x01>;
		redistributor-stride = <0x00 0x40000>;
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;
		reg = <0x00 0x16000000 0x00 0x10000 0x00 0x16080000 0x00 0x200000>;
		interrupts = <0x01 0x09 0x04>;
		phandle = <0x01>;

		gic_its: msi-controller@16040000 {
			compatible = "arm,gic-v3-its";
			reg = <0x00 0x16040000 0x00 0x20000>;
			msi-controller;
			#msi-cells = <0x01>;
			phandle = <0x7d>;
		};
	};

	timer {
		compatible = "arm,armv8-timer";
		interrupts = <0x01 0x0d 0x08 0x01 0x0e 0x08 0x01 0x0b 0x08 0x01 0x0a 0x08>;
		clock-frequency = <0x124f800>;
		always-on;
	};

	pdc: interrupt-controller@b220000 {
		compatible = "qcom,sm8750-pdc", "qcom,pdc";
		reg = <0x00 0xb220000 0x00 0x10000 0x00 0x164400f0 0x00 0x64>;
		qcom,pdc-ranges = <0x00 0x2e9 0x33 0x33 0x20f 0x2f 0x62 0x261 0x20 0x82 0x2cd 0x0c 0x8e 0xfb 0x05 0x93 0x31c 0x10>;
		#interrupt-cells = <0x02>;
		interrupt-parent = <0x01>;
		interrupt-controller;
		phandle = <0x06>;
	};

	spmi_bus: spmi@c400000 {
		compatible = "qcom,spmi-pmic-arb";
		reg = <0x00 0xc400000 0x00 0x3000 0x00 0xc500000 0x00 0x400000 0x00 0xc440000 0x00 0x80000 0x00 0xc4c0000 0x00 0x10000 0x00 0xc42d000 0x00 0x4000>;
		reg-names = "core", "chnls", "obsrvr", "intr", "cnfg";
		interrupts-extended = <0x06 0x01 0x04>;
		interrupt-names = "periph_irq";
		qcom,ee = <0x00>;
		qcom,channel = <0x00>;
		qcom,bus-id = <0x00>;
		interrupt-controller;
		#interrupt-cells = <0x04>;
		#address-cells = <0x02>;
		#size-cells = <0x00>;
		phandle = <0x07>;

		pmic@0 {
			compatible = "qcom,pm8550", "qcom,spmi-pmic";
			reg = <0x00 0x00>;
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			interrupt-parent = <0x07>;

			pon@1300 {
				compatible = "qcom,pmk8350-pon";
				reg = <0x1300 0x800>;
				reg-names = "hlos", "pbs";

				pwrkey {
					compatible = "qcom,pmk8350-pwrkey";
					interrupts = <0x00 0x13 0x07 0x03>;
					linux,code = <0x74>;
				};

				resin {
					compatible = "qcom,pmk8350-resin";
					interrupts = <0x00 0x13 0x06 0x03>;
					linux,code = <0x73>;
				};
			};
		};

		pmic@1 {
			compatible = "qcom,pm8550", "qcom,spmi-pmic";
			reg = <0x01 0x00>;
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			interrupt-parent = <0x07>;

			pm8550_gpios: gpio@8800 {
				compatible = "qcom,pm8550-gpio", "qcom,spmi-gpio";
				reg = <0x8800>;
				gpio-controller;
				gpio-ranges = <0x08 0x00 0x00 0x0c>;
				#gpio-cells = <0x02>;
				interrupt-controller;
				#interrupt-cells = <0x02>;
				phandle = <0x08>;

				volume_down_n: volume-down-state {
					pins = "gpio6";
					function = "normal";
					input-enable;
					bias-pull-up;
					power-source = <0x01>;
					phandle = <0x0c>;
				};
			};
		};

		pmic@7 {
			compatible = "qcom,pmih0108", "qcom,spmi-pmic";
			reg = <0x07 0x00>;
			#address-cells = <0x01>;
			#size-cells = <0x00>;

			eusb_repeater: phy@fd00 {
				compatible = "qcom,pm8550b-eusb2-repeater";
				reg = <0xfd00>;
				#phy-cells = <0x00>;
				vdd18-supply = <0x09>;
				vdd3-supply = <0x0a>;
				qcom,tune-usb2-amplitude = [0b];
				qcom,tune-usb2-disc-thres = [07];
				qcom,squelch-detector-bp = <0xfffff830>;
				qcom,tune-usb2-preem = [03];
				phandle = <0x19>;
			};
		};

		pm8550ve_f: pmic@5 {
			compatible = "qcom,pm8550ve", "qcom,spmi-pmic";
			reg = <0x05 0x00>;
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			interrupt-parent = <0x07>;
			phandle = <0xa1>;

			pm8550ve_f_gpios: gpio@8800 {
				compatible = "qcom,pm8550ve-gpio", "qcom,spmi-gpio";
				reg = <0x8800>;
				gpio-controller;
				gpio-ranges = <0x0b 0x00 0x00 0x06>;
				#gpio-cells = <0x02>;
				interrupt-controller;
				#interrupt-cells = <0x02>;
				phandle = <0x0b>;

				bt_en_state: bt-enable-state {
					pins = "gpio3";
					function = "normal";
					power-source = <0x01>;
					bias-disable;
					output-enable;
					input-disable;
					phandle = <0x8f>;
				};
			};
		};
	};

	gpio-keys {
		compatible = "gpio-keys";
		label = "opd2413-volume-down";
		pinctrl-names = "default";
		pinctrl-0 = <0x0c>;

		volume-down {
			label = "Volume Down";
			linux,code = <0x72>;
			gpios = <0x08 0x06 0x01>;
			debounce-interval = <0x0f>;
		};
	};

	gcc: clock-controller@100000 {
		compatible = "qcom,sm8750-gcc";
		reg = <0x00 0x100000 0x00 0x1f4200>;
		clocks = <0x0d 0x00 0x0e 0x0f 0x10 0x00 0x10 0x01 0x10 0x02 0x00>;
		#clock-cells = <0x01>;
		#reset-cells = <0x01>;
		#power-domain-cells = <0x01>;
		power-domains = <0x02 0x00 0x02 0x08>;
		power-domain-names = "cx", "mx";
		phandle = <0x15>;
	};

	tcsrcc: clock-controller@f204008 {
		compatible = "qcom,sm8750-tcsr", "syscon";
		reg = <0x00 0xf204008 0x00 0x3004>;
		clocks = <0x11 0x00>;
		#clock-cells = <0x01>;
		#reset-cells = <0x01>;
		phandle = <0x16>;
	};

	apps_rsc: rsc@16500000 {
		compatible = "qcom,rpmh-rsc";
		reg = <0x00 0x16500000 0x00 0x10000 0x00 0x16510000 0x00 0x10000 0x00 0x16520000 0x00 0x10000>;
		reg-names = "drv-0", "drv-1", "drv-2";
		interrupts = <0x00 0x03 0x04 0x00 0x04 0x04 0x00 0x05 0x04>;
		qcom,tcs-offset = <0xd00>;
		qcom,drv-id = <0x02>;
		qcom,tcs-config = <0x02 0x03 0x00 0x02 0x01 0x02 0x03 0x00>;
		label = "apps_rsc";
		phandle = <0xa2>;

		apps_bcm_voter: bcm-voter {
			compatible = "qcom,bcm-voter";
			phandle = <0x14>;
		};

		rpmhcc: clock-controller {
			compatible = "qcom,sm8750-rpmh-clk";
			clocks = <0x12>;
			clock-names = "xo";
			#clock-cells = <0x01>;
			phandle = <0x11>;
		};

		rpmhpd: power-controller {
			compatible = "qcom,sm8750-rpmhpd";
			operating-points-v2 = <0x13>;
			#power-domain-cells = <0x01>;
			phandle = <0x02>;

			rpmhpd_opp_table: opp-table {
				compatible = "operating-points-v2";
				phandle = <0x13>;

				rpmhpd_opp_ret: opp-16 {
					opp-level = <0x10>;
					phandle = <0xa3>;
				};

				rpmhpd_opp_min_svs: opp-48 {
					opp-level = <0x30>;
					phandle = <0xa4>;
				};

				rpmhpd_opp_low_svs_d3: opp-50 {
					opp-level = <0x32>;
					phandle = <0xa5>;
				};

				rpmhpd_opp_low_svs_d2: opp-52 {
					opp-level = <0x34>;
					phandle = <0xa6>;
				};

				rpmhpd_opp_low_svs_d1: opp-56 {
					opp-level = <0x38>;
					phandle = <0x63>;
				};

				rpmhpd_opp_low_svs_d0: opp-60 {
					opp-level = <0x3c>;
					phandle = <0xa7>;
				};

				rpmhpd_opp_low_svs: opp-64 {
					opp-level = <0x40>;
					phandle = <0x30>;
				};

				rpmhpd_opp_low_svs_l1: opp-80 {
					opp-level = <0x50>;
					phandle = <0xa8>;
				};

				rpmhpd_opp_svs: opp-128 {
					opp-level = <0x80>;
					phandle = <0x64>;
				};

				rpmhpd_opp_svs_l0: opp-144 {
					opp-level = <0x90>;
					phandle = <0xa9>;
				};

				rpmhpd_opp_svs_l1: opp-192 {
					opp-level = <0xc0>;
					phandle = <0x65>;
				};

				rpmhpd_opp_svs_l2: opp-224 {
					opp-level = <0xe0>;
					phandle = <0xaa>;
				};

				rpmhpd_opp_nom: opp-256 {
					opp-level = <0x100>;
					phandle = <0x1a>;
				};

				rpmhpd_opp_nom_l1: opp-320 {
					opp-level = <0x140>;
					phandle = <0x03>;
				};

				rpmhpd_opp_nom_l2: opp-336 {
					opp-level = <0x150>;
					phandle = <0xab>;
				};

				rpmhpd_opp_turbo: opp-384 {
					opp-level = <0x180>;
					phandle = <0xac>;
				};

				rpmhpd_opp_turbo_l1: opp-416 {
					opp-level = <0x1a0>;
					phandle = <0xad>;
				};

				rpmhpd_opp_turbo_l2: opp-432 {
					opp-level = <0x1b0>;
					phandle = <0xae>;
				};

				rpmhpd_opp_turbo_l3: opp-448 {
					opp-level = <0x1c0>;
					phandle = <0xaf>;
				};

				rpmhpd_opp_turbo_l4: opp-452 {
					opp-level = <0x1c4>;
					phandle = <0xb0>;
				};

				rpmhpd_opp_super_turbo_no_cpr: opp-480 {
					opp-level = <0x1e0>;
					phandle = <0xb1>;
				};
			};
		};

		usb-regulators-b {
			compatible = "qcom,pm8550-rpmh-regulators";
			qcom,pmic-id = "b";

			vreg_l5b: ldo5 {
				regulator-name = "opd2413-usb-l5b";
				regulator-min-microvolt = <0x2f4d60>;
				regulator-max-microvolt = <0x3008e0>;
				phandle = <0x0a>;
			};

			vreg_l15b: ldo15 {
				regulator-name = "opd2413-usb-l15b";
				regulator-min-microvolt = <0x1b7740>;
				regulator-max-microvolt = <0x1b7740>;
				phandle = <0x09>;
			};

			vreg_l12b: ldo12 {
				regulator-name = "opd2413-panel-vddio-l12b";
				regulator-min-microvolt = <0x1cfde0>;
				regulator-max-microvolt = <0x1d0d80>;
				regulator-initial-mode = <0x03>;
				phandle = <0x2c>;
			};

			vreg_l17b: ldo17 {
				regulator-name = "opd2413-ufs-vcc-l17b";
				regulator-min-microvolt = <0x263540>;
				regulator-max-microvolt = <0x263540>;
				regulator-initial-mode = <0x03>;
				regulator-allowed-modes = <0x01 0x03>;
				regulator-allow-set-load;
				phandle = <0x79>;
			};
		};

		usb-regulators-d {
			compatible = "qcom,pm8550ve-rpmh-regulators";
			qcom,pmic-id = "d";

			vreg_l2d: ldo2 {
				regulator-name = "opd2413-usb-l2d";
				regulator-min-microvolt = <0xd6d80>;
				regulator-max-microvolt = <0xdea80>;
				phandle = <0x17>;
			};

			vreg_l1d: ldo1 {
				regulator-name = "opd2413-ufs-vccq-l1d";
				regulator-min-microvolt = <0x124f80>;
				regulator-max-microvolt = <0x124f80>;
				regulator-initial-mode = <0x03>;
				regulator-allowed-modes = <0x01 0x03>;
				regulator-allow-set-load;
				phandle = <0x7a>;
			};

			vreg_s4d: smps4 {
				regulator-name = "opd2413-wireless-aon-s4d";
				regulator-min-microvolt = <0x7a120>;
				regulator-max-microvolt = <0xfcee0>;
				phandle = <0x92>;
			};
		};

		usb-regulators-g {
			compatible = "qcom,pm8550ve-rpmh-regulators";
			qcom,pmic-id = "g";

			vreg_l3g: ldo3 {
				regulator-name = "opd2413-usb-l3g";
				regulator-min-microvolt = <0x124f80>;
				regulator-max-microvolt = <0x124f80>;
				regulator-initial-mode = <0x03>;
				regulator-allowed-modes = <0x01 0x03>;
				regulator-allow-set-load;
				phandle = <0x18>;
			};

			vreg_s3g: smps3 {
				regulator-name = "opd2413-wireless-rfa1-s3g";
				regulator-min-microvolt = <0x1c5200>;
				regulator-max-microvolt = <0x1e8480>;
				phandle = <0x94>;
			};
		};

		usb-refgen-f {
			compatible = "qcom,pm8550ve-rpmh-regulators";
			qcom,pmic-id = "f";

			vreg_l1f: ldo1 {
				regulator-name = "opd2413-usb-refgen-l1f";
				regulator-min-microvolt = <0xd6d80>;
				regulator-max-microvolt = <0xd6d80>;
				regulator-boot-on;
				regulator-always-on;
				regulator-initial-mode = <0x01>;
				regulator-allowed-modes = <0x01 0x03>;
				regulator-allow-set-load;
				phandle = <0x77>;
			};

			vreg_s5f: smps5 {
				regulator-name = "opd2413-wireless-dig-s5f";
				regulator-min-microvolt = <0x7a120>;
				regulator-max-microvolt = <0xf4240>;
				phandle = <0x93>;
			};

			vreg_l2f: ldo2 {
				regulator-name = "opd2413-wireless-io12-l2f";
				regulator-min-microvolt = <0x124f80>;
				regulator-max-microvolt = <0x124f80>;
				regulator-boot-on;
				regulator-always-on;
				regulator-allow-set-load;
				regulator-allowed-modes = <0x01 0x03>;
				phandle = <0x91>;
			};

			vreg_l3f: ldo3 {
				regulator-name = "opd2413-wireless-io-l3f";
				regulator-min-microvolt = <0x1b7740>;
				regulator-max-microvolt = <0x1b7740>;
				regulator-boot-on;
				regulator-always-on;
				regulator-allow-set-load;
				regulator-allowed-modes = <0x01 0x03>;
				phandle = <0x90>;
			};
		};

		display-regulators-i {
			compatible = "qcom,pm8550ve-rpmh-regulators";
			qcom,pmic-id = "i";

			vreg_l3i: ldo3 {
				regulator-name = "opd2413-dsi-phy-l3i";
				regulator-min-microvolt = <0xd6d80>;
				regulator-max-microvolt = <0xd6d80>;
				regulator-initial-mode = <0x03>;
				regulator-allowed-modes = <0x01 0x03>;
				regulator-allow-set-load;
				phandle = <0x70>;
			};

			vreg_s7i: smps7 {
				regulator-name = "opd2413-ufs-parent-s7i";
				regulator-min-microvolt = <0x12ad40>;
				regulator-max-microvolt = <0x147260>;
				regulator-initial-mode = <0x00>;
				regulator-allowed-modes = <0x00 0x03>;
				regulator-allow-set-load;
				qcom,smps-load-mode-threshold-microamp = <0x30d40>;
				phandle = <0x7c>;
			};

			vreg_l2i: ldo2 {
				regulator-name = "opd2413-ufs-ref-pad-l2i";
				regulator-min-microvolt = <0x124f80>;
				regulator-max-microvolt = <0x124f80>;
				regulator-initial-mode = <0x00>;
				regulator-allowed-modes = <0x00 0x03>;
				regulator-allow-set-load;
				qcom,ldo-low-load-retention;
				phandle = <0x7b>;
			};
		};

		storage-regulators-j {
			compatible = "qcom,pm8550vs-rpmh-regulators";
			qcom,pmic-id = "j";

			vreg_l1j: ldo1 {
				regulator-name = "opd2413-ufs-analog-l1j";
				regulator-min-microvolt = <0xdea80>;
				regulator-max-microvolt = <0xdea80>;
				regulator-initial-mode = <0x03>;
				regulator-allowed-modes = <0x01 0x03>;
				regulator-allow-set-load;
				phandle = <0x76>;
			};
		};
	};

	clk_virt: interconnect-0 {
		compatible = "qcom,sm8750-clk-virt";
		#interconnect-cells = <0x02>;
		qcom,bcm-voters = <0x14>;
		phandle = <0x26>;
	};

	mc_virt: interconnect-1 {
		compatible = "qcom,sm8750-mc-virt";
		#interconnect-cells = <0x02>;
		qcom,bcm-voters = <0x14>;
		phandle = <0x1c>;
	};

	cnoc_main: interconnect@1500000 {
		compatible = "qcom,sm8750-cnoc-main";
		reg = <0x00 0x1500000 0x00 0x16080>;
		qcom,bcm-voters = <0x14>;
		#interconnect-cells = <0x02>;
		phandle = <0x7f>;
	};

	config_noc: interconnect@1600000 {
		compatible = "qcom,sm8750-config-noc";
		reg = <0x00 0x1600000 0x00 0x6200>;
		qcom,bcm-voters = <0x14>;
		#interconnect-cells = <0x02>;
		phandle = <0x1e>;
	};

	system_noc: interconnect@1680000 {
		compatible = "qcom,sm8750-system-noc";
		reg = <0x00 0x1680000 0x00 0x1d080>;
		qcom,bcm-voters = <0x14>;
		#interconnect-cells = <0x02>;
		phandle = <0xb2>;
	};

	pcie_noc: interconnect@16c0000 {
		compatible = "qcom,sm8750-pcie-anoc";
		reg = <0x00 0x16c0000 0x00 0x11400>;
		qcom,bcm-voters = <0x14>;
		#interconnect-cells = <0x02>;
		clocks = <0x15 0x01 0x15 0x03>;
		phandle = <0x7e>;
	};

	aggre1_noc: interconnect@16e0000 {
		compatible = "qcom,sm8750-aggre1-noc";
		reg = <0x00 0x16e0000 0x00 0x16400>;
		qcom,bcm-voters = <0x14>;
		#interconnect-cells = <0x02>;
		clocks = <0x15 0x01 0x15 0x03>;
		phandle = <0x1b>;
	};

	aggre2_noc: interconnect@1700000 {
		compatible = "qcom,sm8750-aggre2-noc";
		reg = <0x00 0x1700000 0x00 0x1f400>;
		qcom,bcm-voters = <0x14>;
		#interconnect-cells = <0x02>;
		clocks = <0x11 0x0c>;
		phandle = <0x21>;
	};

	gem_noc: interconnect@24100000 {
		compatible = "qcom,sm8750-gem-noc";
		reg = <0x00 0x24100000 0x00 0x14b080>;
		qcom,bcm-voters = <0x14>;
		#interconnect-cells = <0x02>;
		phandle = <0x1d>;
	};

	apps_smmu: iommu@15000000 {
		compatible = "qcom,sm8750-smmu-500", "qcom,smmu-500", "arm,mmu-500";
		reg = <0x00 0x15000000 0x00 0x100000>;
		interrupts = <0x00 0x41 0x04 0x00 0x61 0x04 0x00 0x62 0x04 0x00 0x63 0x04 0x00 0x64 0x04 0x00 0x65 0x04 0x00 0x66 0x04 0x00 0x67 0x04 0x00 0x68 0x04 0x00 0x69 0x04 0x00 0x6a 0x04 0x00 0x6b 0x04 0x00 0x6c 0x04 0x00 0x6d 0x04 0x00 0x6e 0x04 0x00 0x6f 0x04 0x00 0x70 0x04 0x00 0x71 0x04 0x00 0x72 0x04 0x00 0x73 0x04 0x00 0x74 0x04 0x00 0x75 0x04 0x00 0x76 0x04 0x00 0xb5 0x04 0x00 0xb6 0x04 0x00 0xb7 0x04 0x00 0xb8 0x04 0x00 0xb9 0x04 0x00 0xba 0x04 0x00 0xbb 0x04 0x00 0xbc 0x04 0x00 0xbd 0x04 0x00 0xbe 0x04 0x00 0xbf 0x04 0x00 0xc0 0x04 0x00 0x13b 0x04 0x00 0x13c 0x04 0x00 0x13d 0x04 0x00 0x13e 0x04 0x00 0x13f 0x04 0x00 0x140 0x04 0x00 0x141 0x04 0x00 0x142 0x04 0x00 0x143 0x04 0x00 0x144 0x04 0x00 0x145 0x04 0x00 0x146 0x04 0x00 0x147 0x04 0x00 0x148 0x04 0x00 0x149 0x04 0x00 0x14a 0x04 0x00 0x14b 0x04 0x00 0x14c 0x04 0x00 0x14d 0x04 0x00 0x14e 0x04 0x00 0x14f 0x04 0x00 0x150 0x04 0x00 0x151 0x04 0x00 0x152 0x04 0x00 0x153 0x04 0x00 0x154 0x04 0x00 0x155 0x04 0x00 0x156 0x04 0x00 0x157 0x04 0x00 0x158 0x04 0x00 0x159 0x04 0x00 0x18b 0x04 0x00 0x18c 0x04 0x00 0x18d 0x04 0x00 0x18e 0x04 0x00 0x18f 0x04 0x00 0x190 0x04 0x00 0x191 0x04 0x00 0x192 0x04 0x00 0x193 0x04 0x00 0x194 0x04 0x00 0x195 0x04 0x00 0x196 0x04 0x00 0x197 0x04 0x00 0x198 0x04 0x00 0x199 0x04 0x00 0x1a2 0x04 0x00 0x1a3 0x04 0x00 0x19c 0x04 0x00 0x1a5 0x04 0x00 0x2c3 0x04 0x00 0x1a7 0x04 0x00 0x1a8 0x04 0x00 0x1a9 0x04 0x00 0x2b2 0x04 0x00 0x2b3 0x04 0x00 0x2b4 0x04 0x00 0x2b5 0x04 0x00 0x2b6 0x04 0x00 0x2b7 0x04 0x00 0x2b8 0x04 0x00 0x2b9 0x04 0x00 0x19a 0x04 0x00 0x1e8 0x04 0x00 0x1e9 0x04 0x00 0x1ea 0x04 0x00 0x1eb 0x04 0x00 0x1ec 0x04 0x00 0x1ed 0x04 0x00 0x1ee 0x04 0x00 0x1ef 0x04 0x00 0x1f0 0x04 0x00 0x1f1 0x04 0x00 0x1f2 0x04 0x00 0x1f3 0x04 0x00 0x1f4 0x04 0x00 0x1f5 0x04 0x00 0x1f6 0x04>;
		#iommu-cells = <0x02>;
		#global-interrupts = <0x01>;
		dma-coherent;
		qcom,preserve-boot-mappings;
		phandle = <0x1f>;
	};

	usb_hsphy: phy@88e3000 {
		compatible = "qcom,sm8750-m31-eusb2-phy";
		reg = <0x00 0x88e3000 0x00 0x29c>;
		clocks = <0x16 0x02>;
		clock-names = "ref";
		resets = <0x15 0x11>;
		#phy-cells = <0x00>;
		status = "okay";
		vdd-supply = <0x17>;
		vdda12-supply = <0x18>;
		phys = <0x19>;
		phandle = <0x20>;
	};

	usb: usb@a600000 {
		compatible = "qcom,sm8750-dwc3", "qcom,snps-dwc3";
		reg = <0x00 0xa600000 0x00 0xfc100>;
		clocks = <0x15 0x0b 0x15 0x9c 0x15 0x03 0x15 0xa1 0x15 0x9e>;
		clock-names = "cfg_noc", "core", "iface", "sleep", "mock_utmi";
		assigned-clocks = <0x15 0x9e 0x15 0x9c>;
		assigned-clock-rates = <0x124f800 0xbebc200>;
		interrupts-extended = <0x01 0x00 0x85 0x04 0x01 0x00 0x82 0x04 0x01 0x00 0x83 0x04 0x06 0x0e 0x03 0x06 0x0f 0x03 0x06 0x11 0x04>;
		interrupt-names = "dwc_usb3", "pwr_event", "hs_phy_irq", "dp_hs_phy_irq", "dm_hs_phy_irq", "ss_phy_irq";
		power-domains = <0x15 0x04>;
		required-opps = <0x1a>;
		resets = <0x15 0x16>;
		interconnects = <0x1b 0x05 0x07 0x1c 0x01 0x07 0x1d 0x02 0x03 0x1e 0x1b 0x03>;
		interconnect-names = "usb-ddr", "apps-usb";
		iommus = <0x1f 0x40 0x00>;
		phys = <0x20>;
		phy-names = "usb2-phy";
		snps,hird-threshold = [00];
		snps,usb2-gadget-lpm-disable;
		snps,dis_u2_susphy_quirk;
		snps,dis_enblslpm_quirk;
		snps,dis-u1-entry-quirk;
		snps,dis-u2-entry-quirk;
		snps,is-utmi-l1-suspend;
		snps,usb3_lpm_capable;
		snps,usb2-lpm-disable;
		snps,has-lpm-erratum;
		tx-fifo-resize;
		dma-coherent;
		dr_mode = "peripheral";
		maximum-speed = "high-speed";
		qcom,select-utmi-as-pipe-clk;
		status = "okay";
		phandle = <0xb3>;
	};

	firmware {

		scm {
			compatible = "qcom,scm-sm8750", "qcom,scm";
			interconnects = <0x21 0x02 0x07 0x1c 0x01 0x07>;
		};

		scmi {
			compatible = "arm,scmi";
			mboxes = <0x22 0x00 0x22 0x02>;
			mbox-names = "tx", "rx";
			shmem = <0x23 0x24>;
			#address-cells = <0x01>;
			#size-cells = <0x00>;

			scmi_dvfs: protocol@13 {
				reg = <0x13>;
				#power-domain-cells = <0x01>;
				phandle = <0x05>;
			};
		};
	};

	clocks {

		xo_board: xo-board {
			compatible = "fixed-clock";
			#clock-cells = <0x00>;
			clock-frequency = <0x493e000>;
			phandle = <0x12>;
		};

		sleep_clk: sleep-clk {
			compatible = "fixed-clock";
			#clock-cells = <0x00>;
			clock-frequency = <0x7d00>;
			phandle = <0x0e>;
		};

		bi_tcxo_div2: bi-tcxo-div2 {
			compatible = "fixed-factor-clock";
			#clock-cells = <0x00>;
			clocks = <0x11 0x00>;
			clock-mult = <0x01>;
			clock-div = <0x02>;
			phandle = <0x0d>;
		};

		bi_tcxo_ao_div2: bi-tcxo-ao-div2 {
			compatible = "fixed-factor-clock";
			#clock-cells = <0x00>;
			clocks = <0x11 0x01>;
			clock-mult = <0x01>;
			clock-div = <0x02>;
			phandle = <0x74>;
		};
	};

	tlmm: pinctrl@f100000 {
		compatible = "qcom,sm8750-tlmm";
		reg = <0x00 0xf100000 0x00 0x102000>;
		interrupts = <0x00 0xd0 0x04>;
		gpio-controller;
		#gpio-cells = <0x02>;
		interrupt-controller;
		#interrupt-cells = <0x02>;
		gpio-ranges = <0x25 0x00 0x00 0xd8>;
		gpio-reserved-ranges = <0x24 0x04 0x4a 0x01>;
		wakeup-parent = <0x06>;
		phandle = <0x25>;

		opd2413_speaker_i2c9: opd2413-speaker-i2c9-state {
			phandle = <0xd0>;
			bias-pull-up = <0x898>;
			drive-strength = <0x02>;
			function = "i2chub0_se9";
			pins = "gpio80", "gpio81";
		};

		opd2413_speaker_i2c4: opd2413-speaker-i2c4-state {
			phandle = <0xcf>;
			bias-pull-up = <0x898>;
			drive-strength = <0x02>;
			function = "i2chub0_se4";
			pins = "gpio72", "gpio73";
		};

		opd2413_bt_uart_active: opd2413-bt-uart-active-state {
			phandle = <0xcd>;

			rx-pins {
				bias-disable;
				drive-strength = <0x02>;
				function = "qup2_se6";
				pins = "gpio27";
			};

			tx-pins {
				bias-pull-up;
				drive-strength = <0x02>;
				function = "qup2_se6";
				pins = "gpio26";
			};

			rts-pins {
				bias-pull-down;
				drive-strength = <0x02>;
				function = "qup2_se6";
				pins = "gpio25";
			};

			cts-pins {
				bias-disable;
				drive-strength = <0x02>;
				function = "qup2_se6";
				pins = "gpio24";
			};
		};

		touch_data6: touch-data6-state {
			pins = "gpio48", "gpio50";
			function = "qup1_se4";
			drive-strength = <0x06>;
			bias-disable;
			phandle = <0x28>;
		};

		touch_data4: touch-data4-state {
			pins = "gpio49", "gpio51";
			function = "qup1_se4";
			drive-strength = <0x04>;
			bias-disable;
			phandle = <0x29>;
		};

		touch_data_sleep: touch-data-sleep-state {
			pins = "gpio48", "gpio49", "gpio50";
			function = "gpio";
			drive-strength = <0x04>;
			bias-pull-down;
			input-enable;
			phandle = <0x2a>;
		};

		touch_cs_sleep: touch-cs-sleep-state {
			pins = "gpio51";
			function = "gpio";
			drive-strength = <0x04>;
			bias-disable;
			input-enable;
			phandle = <0x2b>;
		};

		touch_irq: touch-irq-state {
			pins = "gpio162";
			function = "gpio";
			drive-strength = <0x08>;
			bias-disable;
			input-enable;
			phandle = <0x2d>;
		};

		backlight_slave_i2c: backlight-slave-i2c-state {
			pins = "gpio12", "gpio13";
			function = "qup2_se3";
			drive-strength = <0x02>;
			bias-pull-up;
			phandle = <0x59>;
		};

		backlight_hub_i2c: backlight-hub-i2c-state {
			pins = "gpio64", "gpio65";
			function = "i2chub0_se0";
			drive-strength = <0x02>;
			bias-pull-up;
			phandle = <0x5a>;
		};

		backlight_bias_gpio: backlight-bias-gpio-state {
			pins = "gpio15", "gpio111", "gpio14";
			function = "gpio";
			drive-strength = <0x08>;
			phandle = <0x5c>;
		};

		panel_reset_n: panel-reset-n-state {
			pins = "gpio98";
			function = "gpio";
			drive-strength = <0x08>;
			phandle = <0x6d>;
		};

		wlan_en_state: wlan-enable-state {
			pins = "gpio16";
			function = "gpio";
			drive-strength = <0x10>;
			bias-pull-up;
			phandle = <0x8b>;
		};

		wlan_sw_state: wlan-sw-state {
			pins = "gpio18";
			function = "wcn_sw_ctrl";
			phandle = <0x8c>;
		};

		wlan_cx_state: wlan-cx-state {
			pins = "gpio19";
			function = "wcn_sw";
			phandle = <0x8d>;
		};

		wlan_sol_state: wlan-sol-state {
			pins = "gpio202";
			function = "gpio";
			drive-strength = <0x04>;
			bias-pull-down;
			phandle = <0x8e>;
		};

		pcie0_pins: pcie0-state {
			phandle = <0x81>;

			perst {
				pins = "gpio102";
				function = "gpio";
				drive-strength = <0x02>;
				bias-pull-down;
			};

			clkreq {
				pins = "gpio103";
				function = "pcie0_clk_req_n";
				drive-strength = <0x02>;
				bias-pull-up;
			};

			wake {
				pins = "gpio104";
				function = "gpio";
				drive-strength = <0x02>;
				bias-pull-up;
			};
		};
	};

	gpi_dma1: dma-controller@a00000 {
		compatible = "qcom,sm8750-gpi-dma", "qcom,sm6350-gpi-dma";
		reg = <0x00 0xa00000 0x00 0x60000>;
		interrupts = <0x00 0x117 0x04 0x00 0x118 0x04 0x00 0x119 0x04 0x00 0x11a 0x04 0x00 0x11b 0x04 0x00 0x11c 0x04 0x00 0x125 0x04 0x00 0x126 0x04 0x00 0x127 0x04 0x00 0x128 0x04 0x00 0x129 0x04 0x00 0x12a 0x04>;
		dma-channels = <0x0c>;
		dma-channel-mask = <0x1e>;
		#dma-cells = <0x03>;
		iommus = <0x1f 0xb6 0x00>;
		status = "okay";
		phandle = <0x27>;
	};

	qupv3_1: geniqup@ac0000 {
		compatible = "qcom,geni-se-qup";
		reg = <0x00 0xac0000 0x00 0x2000>;
		clocks = <0x15 0x7d 0x15 0x7e>;
		clock-names = "m-ahb", "s-ahb";
		iommus = <0x1f 0xa3 0x00>;
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;
		status = "okay";
		phandle = <0xb4>;

		spi4: spi@a90000 {
			compatible = "qcom,geni-spi";
			reg = <0x00 0xa90000 0x00 0x4000>;
			interrupts = <0x00 0x165 0x04>;
			clocks = <0x15 0x60>;
			clock-names = "se";
			interconnects = <0x26 0x01 0x07 0x26 0x04 0x07 0x1d 0x02 0x07 0x1e 0x13 0x07 0x1b 0x01 0x07 0x1c 0x01 0x07>;
			interconnect-names = "qup-core", "qup-config", "qup-memory";
			dmas = <0x27 0x00 0x04 0x01 0x27 0x01 0x04 0x01>;
			dma-names = "tx", "rx";
			pinctrl-0 = <0x28 0x29>;
			pinctrl-1 = <0x2a 0x2b>;
			pinctrl-names = "default", "sleep", "init";
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			status = "okay";
			vddio-supply = <0x2c>;
			qcom,preserve-boot-io;
			pinctrl-2 = <0x2a 0x2b>;
			phandle = <0xb5>;

			touchscreen@0 {
				compatible = "oneplus,opd2413-nt36536", "novatek,nt36536-ts";
				reg = <0x00>;
				interrupt-parent = <0x25>;
				interrupts = <0xa2 0x02>;
				pinctrl-0 = <0x2d>;
				pinctrl-names = "default";
				spi-max-frequency = <0x989680>;
				firmware-name = "opd2413-xn242-nt36536.bin";
				touchscreen-size-x = <0x5dc0>;
				touchscreen-size-y = <0x8480>;
				status = "okay";
